[Unit]
Description=mayfly: tell the bootloader this slot booted, so it stops counting down
After=lxc-android-config.service

[Service]
# Without this the phone eventually hangs on the splash screen for no visible
# reason. Qualcomm's A/B is kept in the GPT attribute bits, not in misc (offset
# 2048 there is all zeros on this device): making a slot active sets
# tries_remaining and clears successful_boot, and ABL decrements the counter on
# every boot until the OS marks the slot good. Android does that from
# update_verifier; Ubuntu Touch has nothing that does, so after a handful of
# reboots ABL declares _b unbootable and falls back to _a, which holds the old
# LineageOS chain and boots nowhere. Recovering needs TWRP and
# "bootctl set-active-boot-slot 1".
#
# The Halium container ships both /system/bin/bootctl and the qti boot HAL, so
# there is nothing to write by hand -- but the HAL sits in binder_wait_for_work
# and is not up when the container is, hence the wait. Marking is idempotent.
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=180
ExecStart=/bin/sh -c 'until /usr/bin/lxc-attach -n android -- /system/bin/bootctl mark-boot-successful; do sleep 2; done'

[Install]
WantedBy=multi-user.target
