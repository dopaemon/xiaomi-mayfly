#!/sbin/sh
# TWRP flashable zip for the boot chain. Structure follows the usual Ubuntu
# Touch flashable zips (update-binary is the script, updater-script a dummy),
# but nothing is unpacked to disk: every image is streamed straight from the
# zip into its partition, so recovery needs no free space and the zip carries
# no busybox.
#
# Only boot/vendor_boot/dtbo. The rootfs still goes through Halium recovery and
# the UT installer, which is what removes product_a/system_ext_a from super and
# grows system_a (see ramdisk-recovery-overlay/prop.halium); doing that from
# TWRP would need lptools and is not worth the risk.

OUTFD=/proc/self/fd/$2
ZIP="$3"

ui_print() {
  until [ ! "$1" ]; do
    echo -e "ui_print $1\nui_print" > $OUTFD
    shift
  done
}
show_progress() { echo "progress $1 $2" > $OUTFD; }
abort() { ui_print "$*"; exit 1; }

show_progress 1.0 3
ui_print " "
ui_print "    _   _ ____                _        "
ui_print "   | | | | __ ) _ __  ___ _ _| |_ ___  "
ui_print "   | | | |  _ \| '_ \/ _ \ '_| __/ __| "
ui_print "   | |_| | |_) | |_) | (_) | | | |_\__ \\"
ui_print "    \___/|____/| .__/ \___/|_|  \__|___/"
ui_print "               |_|                     "
ui_print " "
ui_print " Ubuntu Touch / Halium 16 - Xiaomi 12S (mayfly)"
ui_print " "

# A/B device: TWRP exports the slot it is running from. Without it we would
# happily write the inactive slot and the phone would boot the old kernel.
SLOT=$(getprop ro.boot.slot_suffix)
[ -n "$SLOT" ] || SLOT=$(grep -o 'androidboot.slot_suffix=[^ ]*' /proc/cmdline | cut -d= -f2)
[ -n "$SLOT" ] || abort " Cannot tell which slot is active. Aborting."
ui_print " Active slot: ${SLOT#_}"

flash() {
  name="$1"
  part="$2"
  target="/dev/block/bootdevice/by-name/${part}${SLOT}"
  [ -e "$target" ] || target="/dev/block/by-name/${part}${SLOT}"
  [ -e "$target" ] || abort " ${part}${SLOT} not found. Aborting."
  unzip -l "$ZIP" "images/$name" > /dev/null 2>&1 || abort " $name missing from zip. Aborting."
  ui_print " Flashing $name -> ${part}${SLOT}"
  # boot.img and vendor_boot.img are padded to the full partition size at build
  # time, so their AVB footer lands where the bootloader looks for it. dtbo.img
  # is not, which is fine only because this port is flashed with verification
  # off.
  unzip -p "$ZIP" "images/$name" | dd of="$target" bs=1M || abort " Writing $name failed. Aborting."
}

# vendor_dlkm is a logical partition inside super, so it has no by-name node
# and its dm-linear extent is a fixed size -- refuse to write past it rather
# than corrupt a neighbour. Optional: older zips do not carry the image.
flash_logical() {
  name="$1"
  part="$2"
  target="/dev/block/mapper/${part}${SLOT}"
  if [ ! -e "$target" ]; then
    ui_print " ${part}${SLOT} not found, skipping $name"
    return 0
  fi
  unzip -l "$ZIP" "images/$name" > /dev/null 2>&1 || {
    ui_print " $name not in zip, skipping"
    return 0
  }
  have=$(unzip -l "$ZIP" "images/$name" | awk '/images\//{print $1; exit}')
  room=$(blockdev --getsize64 "$target" 2>/dev/null || echo 0)
  if [ -n "$have" ] && [ "$room" -gt 0 ] && [ "$have" -gt "$room" ]; then
    abort " $name ($have B) does not fit ${part}${SLOT} ($room B). Aborting."
  fi
  ui_print " Flashing $name -> ${part}${SLOT}"
  unzip -p "$ZIP" "images/$name" | dd of="$target" bs=1M || abort " Writing $name failed. Aborting."
}

flash boot.img boot
show_progress 0.25 1
flash vendor_boot.img vendor_boot
show_progress 0.25 1
# The stock overlays, straight from prebuilt/dtbo.img: ABL matches them against
# the base DTBs in vendor_boot and drops to fastboot if they do not agree, so a
# self-built dtbo bricks the boot. deviceinfo pins deviceinfo_prebuilt_dtbo for
# the same reason -- never replace this with a built one.
flash dtbo.img dtbo
show_progress 0.5 1

# recovery.img is deliberately NOT flashed here. Halium recovery shares the
# 100 MiB recovery partition with TWRP, and this zip is installed from TWRP --
# flashing it would destroy the only rescue path back to a wedged rootfs.
# It ships as a separate release asset; fastboot it by hand when the UT
# installer needs it, and reflash TWRP afterwards.
# Our modules, built against our kernel. The stock ones are built against
# 5.10.245 and every insmod fails vermagic, taking msm_drm and the display with
# them.
flash_logical vendor_dlkm.img vendor_dlkm

ui_print " "
ui_print " Done. TWRP was left alone; flash recovery.img by"
ui_print " hand if you need the UT installer."
ui_print " "
