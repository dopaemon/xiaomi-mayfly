# Xiaomi 12S Pro (mayfly), SM8475 / waipio family, Halium 16
deviceinfo_name="Xiaomi 12S Pro"
deviceinfo_manufacturer="Xiaomi"
deviceinfo_codename="mayfly"
deviceinfo_arch="aarch64"

##### Kernel
deviceinfo_kernel_source="https://github.com/dopaemon/android_kernel_xiaomi_common.git"
deviceinfo_kernel_source_branch="halium-16.0"

# Checked out next to the kernel, where its in-tree symlinks expect them:
#   arch/arm64/boot/dts/vendor -> ../../../../../sm8450-devicetrees
deviceinfo_kernel_extra_repos="
sm8450-devicetrees=https://github.com/LineageOS/android_kernel_xiaomi_sm8450-devicetrees.git#lineage-23.0
sm8450-modules=https://github.com/LineageOS/android_kernel_xiaomi_sm8450-modules.git#lineage-23.0
"

deviceinfo_kernel_clang_compile="true"
deviceinfo_kernel_llvm_compile="true"
# Halium 16 defaults to r510928 (2024), too new for this 5.10 tree.
# Knob: bump if the kernel or modules stop building.
deviceinfo_kernel_clang_branch="master-kernel-build-2022"
deviceinfo_kernel_clang_revision="r450784e"

deviceinfo_kernel_image_name="Image"
# A fragment containing "/" is resolved relative to the downloads dir, not to
# arch/arm64/configs (build-kernel.sh), so the vendor ones need the full path.
# The same rule lets ../../selinux.config reach this repo: fragments resolve
# relative to workdir/downloads/, and this repo is workdir's parent, two
# levels up. Has to come after halium.config to undo its LSM ordering.
deviceinfo_kernel_defconfig="gki_defconfig \
    android_kernel_xiaomi_common/arch/arm64/configs/vendor/waipio_GKI.config \
    android_kernel_xiaomi_common/arch/arm64/configs/vendor/xiaomi_GKI.config \
    android_kernel_xiaomi_common/arch/arm64/configs/vendor/mayfly_GKI.config \
    halium.config \
    ../../selinux.config"

# Same set and order as TARGET_KERNEL_EXT_MODULES in sm8450-common/BoardConfigCommon.mk
deviceinfo_kernel_external_modules="
sm8450-modules/qcom/opensource/mmrm-driver
sm8450-modules/qcom/opensource/audio-kernel
sm8450-modules/qcom/opensource/camera-kernel
sm8450-modules/qcom/opensource/cvp-kernel
sm8450-modules/qcom/opensource/dataipa/drivers/platform/msm
sm8450-modules/qcom/opensource/datarmnet/core
sm8450-modules/qcom/opensource/datarmnet-ext/aps
sm8450-modules/qcom/opensource/datarmnet-ext/offload
sm8450-modules/qcom/opensource/datarmnet-ext/shs
sm8450-modules/qcom/opensource/datarmnet-ext/perf
sm8450-modules/qcom/opensource/datarmnet-ext/perf_tether
sm8450-modules/qcom/opensource/datarmnet-ext/sch
sm8450-modules/qcom/opensource/datarmnet-ext/wlan
sm8450-modules/qcom/opensource/display-drivers/msm
sm8450-modules/qcom/opensource/eva-kernel
sm8450-modules/qcom/opensource/video-driver
sm8450-modules/qcom/opensource/wlan/qcacld-3.0/.qca6490
sm8450-modules/qcom/opensource/wlan/qcacld-3.0/.qca6750
"

# Stock boot.img carries an empty cmdline; everything lives in vendor_boot,
# with the androidboot.* keys in bootconfig (see ./bootconfig). The bootloader
# adds androidboot.slot_suffix there too, not on the command line, which the
# stock initrd does not read -- see ramdisk-overlay/scripts/halium.
# console=tty0: the only console the kernel registers on its own is ramoops,
# and msm_geni_serial disables the ttyMSM0 one ("Console Disabled"), so
# /dev/console opens ENODEV. The initrd's validate_init() is `run-init -n`,
# which opens /dev/console before anything else -- without a console it fails
# for every init candidate and the initrd panics with "No init found" on a
# perfectly good rootfs. CONFIG_VT is in, so tty0 is always available.
deviceinfo_kernel_vendor_cmdline="video=vfb:640x400,bpp=32,memsize=3072000 disable_dma32=on bootconfig console=tty0 systempart=/dev/mapper/system"
deviceinfo_vendor_bootconfig_path="bootconfig"

##### Boot image
deviceinfo_bootimg_header_version="4"
deviceinfo_flash_pagesize="4096"
deviceinfo_flash_offset_base="0x00000000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x01000000"
# Unused by header v4, but make-bootimage.sh passes it verbatim when building
# recovery.img as a header v2 image.
deviceinfo_flash_offset_second="0x00000000"
deviceinfo_flash_offset_tags="0x00000100"
deviceinfo_flash_offset_dtb="0x01f00000"
# BOARD_BOOTIMAGE_PARTITION_SIZE 0x0C000000
deviceinfo_bootimg_partition_size="$((192*$((2**20))))"
# BOARD_VENDOR_BOOTIMAGE_PARTITION_SIZE 0x06000000
deviceinfo_vendor_boot_partition_size="$((96*$((2**20))))"
# Stock boot.img header says 12.0.0 / 2025-02; keep it identical.
# This is the boot header field, unrelated to deviceinfo_halium_version.
deviceinfo_bootimg_os_version="12"
deviceinfo_bootimg_os_patch_level="2025-02"
deviceinfo_ramdisk_compression="lz4"

# Stock blobs, not ours. ABL matches the dtbo overlays against the base DTBs in
# vendor_boot by id/rev: stock ships 14 base DTBs and 92 overlays, while the
# tree here only builds 3 bases (cape = Cape SoC, cape-v2 = Cape LTE Only,
# capep = CapeP) and the one mayfly overlay. Flashing either of ours leaves the
# other 89 overlays -- panel, charger, thermal -- with nothing to attach to, and
# the bootloader gives up and drops to fastboot. Verified on device: our
# vendor_boot DTB (1136115 B) never boots, the stock blob (6687382 B) always
# does. Paths are relative to this repo ($HERE in make-bootimage.sh:253,281).
#
# To go back to building them, set deviceinfo_dtb/deviceinfo_dtbo below instead
# -- but the missing base DTBs and overlays have to be built first:
#   deviceinfo_dtb="vendor/qcom/cape.dtb vendor/qcom/cape-v2.dtb vendor/qcom/capep.dtb"
#   deviceinfo_dtbo="vendor/qcom/mayfly-sm8475-pm8008-overlay.dtbo"
# (those paths are relative to KERNEL_OBJ/arch/arm64/boot/dts/, where the
# in-tree symlink puts them under vendor/qcom/.)
deviceinfo_bootimg_prebuilt_dtb="prebuilt/mayfly.dtb"
deviceinfo_prebuilt_dtbo="prebuilt/dtbo.img"

##### Recovery
deviceinfo_use_unified_recovery="true"
# mayfly is not recovery-as-boot: rawprogram lists recovery_a/recovery_b at
# 102400 KB each, and the LineageOS BoardConfig has
# BOARD_RECOVERYIMAGE_PARTITION_SIZE := 0x06400000 with no
# BOARD_USES_RECOVERY_AS_BOOT. So recovery goes to its own partition rather
# than being appended to the boot ramdisk -- the appended form is only entered
# when the bootloader withholds androidboot.force_normal_boot, which a device
# with a real recovery partition has no reason to do (it would boot straight
# into recovery every time).
deviceinfo_has_recovery_partition="true"
deviceinfo_recovery_partition_size="104857600"
# TARGET_SCREEN_DENSITY 440
deviceinfo_unified_recovery_ui_density="xxhdpi"

##### Rootfs
deviceinfo_rootfs_image_sector_size="4096"
deviceinfo_system_partition_size="4500M"
deviceinfo_halium_version="16"
deviceinfo_ubuntu_touch_release="24.04-2.x"
